{
  "name": "emp-portal",
  "version": "1.0.0",
  "description": "Multi-tenant Employee & Employer Portal - Full Stack Application",
  "main": "backend/dist/server.js",
  "private": true,
  "scripts": {
    "dev": "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"blue,magenta\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "watch": "concurrently --names \"BACKEND,FRONTEND\" --prefix-colors \"blue,magenta\" \"npm run watch:backend\" \"npm run watch:frontend\"",
    "dev:frontend": "ng serve --host 0.0.0.0 --port 4200",
    "dev:backend": "nodemon --exec ts-node -r dotenv/config backend/src/server.ts dotenv_config_path=.env --watch backend/src --ext ts,js,json",
    "watch:frontend": "ng build --watch --configuration development --delete-output-path false",
    "watch:backend": "nodemon --exec ts-node -r dotenv/config backend/src/server.ts dotenv_config_path=.env --watch backend/src --ext ts,js,json --verbose",
    "build": "npm run build:backend && npm run build:frontend",
    "build:frontend": "ng build --configuration production",
    "build:backend": "tsc --project tsconfig.backend.json",
    "build:watch": "concurrently \"npm run build:backend -- --watch\" \"npm run build:frontend -- --watch\"",
    "start": "node -r dotenv/config backend/dist/server.js dotenv_config_path=.env",
    "start:frontend": "ng serve --configuration production",
    "start:backend": "node -r dotenv/config backend/dist/server.js dotenv_config_path=.env",
    "test": "npm run test:backend && npm run test:frontend",
    "test:frontend": "ng test",
    "test:backend": "jest --config backend/jest.config.js",
    "test:watch": "concurrently \"npm run test:backend -- --watch\" \"npm run test:frontend -- --watch\"",
    "lint": "npm run lint:backend && npm run lint:frontend",
    "lint:frontend": "ng lint",
    "lint:backend": "eslint backend/src/**/*.ts",
    "clean": "rimraf backend/dist frontend/dist node_modules/.cache"
  },
  "keywords": [
    "employee",
    "employer",
    "portal",
    "multi-tenant",
    "timesheet",
    "document-management",
    "angular",
    "nodejs",
    "express",
    "mongodb"
  ],
  "author": "",
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0",
    "npm": ">=9.0.0"
  },
  "dependencies": {
    "@angular/animations": "^17.0.0",
    "@angular/cdk": "^17.0.0",
    "@angular/common": "^17.0.0",
    "@angular/compiler": "^17.0.0",
    "@angular/core": "^17.0.0",
    "@angular/forms": "^17.0.0",
    "@angular/material": "^17.0.0",
    "@angular/platform-browser": "^17.0.0",
    "@angular/platform-browser-dynamic": "^17.0.0",
    "@angular/router": "^17.0.0",
    "bcryptjs": "^2.4.3",
    "compression": "^1.7.4",
    "connect-mongo": "^5.1.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dayjs": "^1.11.10",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "express-session": "^1.17.3",
    "express-validator": "^7.0.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^6.9.7",
    "pdfkit": "^0.13.0",
    "rxjs": "^7.8.1",
    "sharp": "^0.33.1",
    "tslib": "^2.6.2",
    "uuid": "^9.0.1",
    "zone.js": "^0.14.2"
  },
  "devDependencies": {
    "@angular-devkit/build-angular": "^17.0.0",
    "@angular/cli": "^17.0.0",
    "@angular/compiler-cli": "^17.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/express-session": "^1.17.10",
    "@types/jest": "^29.5.11",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/multer": "^1.4.13",
    "@types/node": "^20.10.6",
    "@types/nodemailer": "^6.4.14",
    "@types/uuid": "^9.0.7",
    "@typescript-eslint/eslint-plugin": "^6.16.0",
    "@typescript-eslint/parser": "^6.16.0",
    "concurrently": "^8.2.2",
    "eslint": "^8.56.0",
    "jest": "^29.7.0",
    "nodemon": "^3.0.2",
    "rimraf": "^5.0.10",
    "ts-node": "^10.9.2",
    "typescript": "^5.3.3"
  },
  "workspaces": [
    "frontend",
    "backend"
  ]
}
